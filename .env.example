# GEMINI_API_KEY: Required if Gemini API server-side integrations are enabled.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Cloud Run injects PORT (default 3000 locally / 8080 or 3000 on Cloud Run).
PORT=3000

# CONSULTATION_RECIPIENT_EMAIL: Target email for pre-filled consultation drafts.
CONSULTATION_RECIPIENT_EMAIL="sales@cloud-11.com"

# CONSULTATION_WEBHOOK_URL: Optional HTTPS webhook (CRM, Slack, Google Chat, or Cloud Function)
# to automatically receive consultation form submissions. Leave empty if not configured.
CONSULTATION_WEBHOOK_URL=""
